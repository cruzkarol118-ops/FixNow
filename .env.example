# Copia este archivo como .env y completa los valores (nunca subas el .env real).
# Clave secreta de Django: genera una propia para producción
# (p. ej. con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())").
SECRET_KEY=dev-only-secret-key-fixnow-local-9f3a1c7e5b2d8406
# Base de datos MariaDB/MySQL (ver README: se necesita MySQL 10.5+ / MariaDB 10.5+).
DB_NAME=fixnow_db
DB_USER=root
# Vacío si tu root local no tiene contraseña; si sí tiene, escríbela aquí.
DB_PASSWORD=

# DB_HOST y DB_PORT: en local es siempre 127.0.0.1:3306; en Railway van los
# valores que da el servicio MySQL (host mysql.railway.internal, puerto 3306).
DB_HOST=127.0.0.1
DB_PORT=3306

# DEBUG=True solo aplica en local; Railway lo lleva en False como variable.
DEBUG=True

# DB_SSL: para BDs externas que exigen TLS (Layerbase). En local no aplica.
# DB_CONNECT_TIMEOUT: segundos que se espera la conexión (Layerbase tarda
# ~20 s en frío al despertar; el default de 30 cubre ese lapso).
# DB_SSL=True
# DB_CONNECT_TIMEOUT=30

# ALLOWED_HOSTS: el default en settings ya cubre Railway (.up.railway.app) y
# localhost; solo se define explícito si la app llega a tener dominio propio.
# ALLOWED_HOSTS=.up.railway.app,localhost,127.0.0.1
